# Rust
/target/
# nanochrono-baremetal is outside the workspace, so it has its own.
/crates/nanochrono-baremetal/target/
# The plugin crates and the host signer are outside the workspace too; a
# stray in-place build leaves a target/ that must never be committed.
/crates/nanochrono-plugins/*/target/
/tools/ncplu-sign/target/

# The old output directory. Every script now writes to build/; kept ignored so
# a stale checkout's dist/ never shows up as untracked.
/dist/
**/*.rs.bk

# Benchmark output
*.log
*.csv
nanochrono-results.csv
nanochrono-bench-*.log

# Editors and desktop cruft
desktop.ini
.DS_Store

# Generated by tools/gen-header.sh: the hosted header from crates/nanochrono-ffi,
# the bare-metal one from crates/nanochrono-baremetal/src/abi.rs
/include/nanochrono.h
/include/baremetal/

# Kernel module build artifacts (kernel/linux)
*.ko
*.mod
*.mod.c
*.o
*.order
*.symvers
.*.cmd
.tmp_versions/

# Windows kernel driver build artifacts (kernel/windows)
/kernel/windows/build/
*.sys

# Signing material — NEVER commit private keys or containers
*.key
*.pem
*.pfx
*.p12
/kernel/windows/certs-private/

# .ncplu hybrid signing keys (tools/ncplu-sign keygen). The private halves —
# the ML-DSA-87 seed and the P-521 scalar — never enter the repository; a key
# directory belongs outside it. Ignored by name in case one is generated here
# by mistake. root_pubkeys.bin is public, but a key dir is not committed.
mldsa.seed
p521.scalar
*.ncplu-key
/keys/
# The same for every key the ecosystem uses (docs/ECOSYSTEM.md, section 3):
# the four creator roots (creator and verification, ring 3 and ring 0) and
# owner (MOK) keys of any algorithm — Ed25519, RSA, ECDSA, ML-DSA, hybrids.
# Private halves never enter the tree; the build reads public keys from
# outside it. Plus the password pepper and a state-partition image, which
# hold secrets of the machine they came from.
*.seed
*.scalar
*.priv
*.secret
*-private.*
*_private.*
*.mok
/keys*/
**/ncplu-keys/
**/mok-keys/
pepper.bin
*.pepper
NCSTATE.BIN

# Per-machine notes for Claude (paths on the maintainer's PC)
/CLAUDE.local.md

# Android release signing: the keystore and its passwords never leave this machine
/packaging/android/keystore/
*.jks
*.keystore

# Release output: every packaging script writes here (packaging/release/
# build-all.sh runs them all); binaries, not source
/build/

# C plugin build output (sdk/Makefile)
/sdk/build/

# Python bytecode from running tools/*.py
__pycache__/

# Core dumps qemu-user writes to the working directory when a program it runs
# dies (qemu-aarch64 build/android/.../nanochrono-static, say)
qemu_*.core
