{
  "abi": "",
  "arch": "powerpc",
  "cpu": "ppc",
  "crt-static-default": false,
  "crt-static-respected": false,
  "data-layout": "E-m:e-p:32:32-Fn32-i64:64-n32",
  "disable-redzone": false,
  "dynamic-linking": true,
  "env": "",
  "exe-suffix": "",
  "executables": true,
  "features": "-altivec",
  "has-thread-local": false,
  "linker": "rust-lld",
  "linker-flavor": "ld.lld",
  "llvm-target": "powerpc-unknown-unknown",
  "max-atomic-width": 32,
  "metadata": {
    "description": "NanoChronometer ring 3 (.ncapp/.ncplu/.ncdyn/.ncar), powerpc",
    "host_tools": false,
    "std": false,
    "tier": 3
  },
  "os": "nanochronometer",
  "panic-strategy": "abort",
  "position-independent-executables": true,
  "relocation-model": "pic",
  "relro-level": "off",
  "stack-probes": {
    "kind": "inline"
  },
  "static-position-independent-executables": true,
  "target-c-int-width": 32,
  "target-endian": "big",
  "target-pointer-width": 32,
  "vendor": "unknown"
}
